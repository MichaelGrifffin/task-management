{
  "name": "task-management-app",
  "version": "1.0.0",
  "description": "Full-stack Task Management Web Application for intern submission",
  "main": "server/index.js",
  "scripts": {
    "build:client": "npm --prefix client install && npm --prefix client run build",
    "build": "npm run build:client",
    "start": "node server/index.js",
    "install:all": "npm install && npm run build:client",
    "server": "cd server && npm start",
    "client": "cd client && npm run dev"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "sqlite3": "^5.1.7",
    "ws": "^8.17.0"
  }
}
